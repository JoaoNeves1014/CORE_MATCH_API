CREATE TABLE IF NOT EXISTS produtos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    marca TEXT NOT NULL,          -- Ex: 'AMD' ou 'INTEL'
    modelo TEXT NOT NULL,         -- Ex: 'Ryzen 5 5600GT'
    preco REAL NOT NULL, -- Armazena o valor numérico puro (ex: 879.00)
    imagem TEXT                   -- Caminho ou URL da imagem do produto
);

-- Inserção dos produtos da imagem
INSERT INTO produtos (marca, modelo, preco, imagem) VALUES 
-- Seção AMD
('AMD', 'AMD Ryzen 5 5600GT', 879.00, '../img/ryzen5-5600gt.png'),
('AMD', 'AMD Ryzen 7 7800X3D', 2220.00, '../img/ryzen7-7800x3d.png'),
('AMD', 'AMD Ryzen 9 9950X3D', 3190.00, '../img/ryzen9-9950x3d.png'),

-- Seção INTEL
('INTEL', 'Intel Core i5 14600F', 1599.00, '../img/core-i5-14600f.png'),
('INTEL', 'Intel Core i7 14700F', 2600.00, '../img/core-i7-14700f.png'),
('INTEL', 'Intel Core i9 14900F', 3680.00, '../img/core-i9-14900f.png');</sql><current_tab id="0"/></tab_sql></sqlb_project>
